[flake8]
max-line-length = 88
select = E,W,F
ignore = 
    E203,  # whitespace before ':'
    E501,  # line too long (handled by black)
    W503,  # line break before binary operator
exclude = 
    .git,
    __pycache__,
    .venv,
    venv,
    alembic/versions,
    *.pyc,
    .pytest_cache
per-file-ignores =
    __init__.py:F401  # Allow unused imports in __init__.py files
max-complexity = 10